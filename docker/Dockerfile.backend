# ── Stage 1: build deps ──────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

RUN pip install uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY shared/ ./shared/
COPY backend/ ./backend/

# Instalar dependencias en un virtualenv aislado
RUN uv sync --project backend --no-dev

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copiar sólo el virtualenv y el código fuente
COPY --from=builder /app/backend/.venv /app/.venv
COPY --from=builder /app/backend/app   /app/app
COPY --from=builder /app/shared        /app/shared

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
