# ── Stage 1: build deps ──────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

RUN pip install uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY shared/ ./shared/
COPY backend/ ./backend/

# Instalar dependencias en un virtualenv aislado
RUN uv sync --project backend --no-dev

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Usuario sin privilegios
RUN groupadd --gid 1000 app && useradd --uid 1000 --gid app --no-create-home app

# Copiar sólo el virtualenv y el código fuente
COPY --from=builder --chown=app:app /app/backend/.venv /app/.venv
COPY --from=builder --chown=app:app /app/backend/app   /app/app
COPY --from=builder --chown=app:app /app/shared        /app/shared

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER app

EXPOSE 8000

# start-period amplio: la carga de modelos ML en el lifespan tarda ~1-2 min
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=4)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
